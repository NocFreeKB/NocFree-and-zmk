#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Conservative default ANSI map.
 *
 * Bindings are listed in visual reading order. Each physical row is the left
 * half, then the right half, then the numpad keys on that row.
 *
 * The retail ANSI keycaps carry Mac legends, so the bottom row reads
 * Fn / Control / Option / Command from the outside in. Option maps to ALT and
 * Command maps to GUI, which is the usual behaviour of a Mac keyboard on any
 * host. The bottom-row modifier order is the least certain part of this map and
 * should be confirmed against the physical legends; changing it is a keymap
 * edit only and does not affect the electrical map.
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6
                &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp PSCRN &kp HOME
                &kp KP_NUM &kp F3 &kp F4 &kp F7

                &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
                &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp PG_UP
                &kp ESC &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS

                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS

                &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp RET   &kp DEL
                &kp KP_N4 &kp KP_N5 &kp KP_N6

                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &kp PG_DN
                &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER

                &mo 1     &kp LCTRL &kp LALT  &kp LGUI  &kp SPACE
                &kp SPACE &kp RGUI  &mo 1     &kp RALT  &kp LEFT  &kp DOWN  &kp RIGHT
                &kp KP_N0 &kp KP_DOT
            >;
        };

        /*
         * Function layer: host controls, Bluetooth profile management, output
         * selection, and the two recovery behaviours.
         *
         *   Fn+1..Fn+5   select Bluetooth profile 0..4
         *   Fn+0         clear the selected Bluetooth profile
         *   Fn+U         send HID over USB
         *   Fn+B         send HID over Bluetooth
         *   Fn+F1/F2     display brightness down/up
         *   Fn+F3        show all windows / Mission Control
         *   Fn+F4        search / Spotlight
         *   Fn+F5/F6     unavailable (keyboard backlight is not implemented)
         *   Fn+F7/F8/F9  previous track, play/pause, next track
         *   Fn+F10/11/12 mute, volume down, volume up
         *   Fn+Esc       reset the left half
         *   Fn+Delete    reboot the right half into its bootloader
         *   Fn+numpad F7    reboot the numpad into its bootloader
         *
         * ZMK reset behaviours act on the part whose key triggered them: Esc
         * is a left-half key, Delete a right-half one, and the numpad
         * F7 a numpad one. Fn+Delete and Fn+numpad-F7 therefore
         * need the split link up. Any part can always be recovered over its
         * USB CDC interface instead; see docs/recovery.md.
         */
        function_layer {
            display-name = "Fn";
            bindings = <
                &sys_reset &kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_SEARCH &trans &trans
                &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &trans
                &trans     &trans     &trans     &bootloader

                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
                &trans     &trans     &trans     &bt BT_CLR &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &out OUT_USB &trans   &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans  &bootloader
                &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &out OUT_BLE
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans
            >;
        };
    };
};
