CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y
CONFIG_PINCTRL=y
CONFIG_I2C=y

# Link and flash only into the preserved application slot.
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Settings live in the dedicated NVS partition, clear of the factory filesystem.
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Warm-reset request into the preserved Adafruit UF2 bootloader.
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y

# See the left defconfig for why the internal RC oscillator is used.
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y

# The numpad is a split peripheral: it has no host-facing HID output.
CONFIG_ZMK_BLE=y

# No battery source is declared: the ADC and divider-enable pins are not
# verified by this port. Reporting would otherwise default on and advertise a
# Battery Service with nothing behind it.
CONFIG_ZMK_BATTERY_REPORTING=n

# USB is brought up only for the CDC recovery interface, so this part keeps a
# host-driven bootloader path that does not depend on the split link. With
# CONFIG_ZMK_USB unset ZMK never calls usb_enable(), so INITIALIZE_AT_BOOT is
# the line that actually enumerates USB here.
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_INITIALIZE_AT_BOOT=y
CONFIG_SERIAL=y
CONFIG_UART_LINE_CTRL=y
CONFIG_USB_CDC_ACM=y
CONFIG_CDC_ACM_DTE_RATE_CALLBACK_SUPPORT=y

# Keep the split link on the 1M PHY; see the left defconfig for the full
# rationale. Set on every part so none can negotiate 2M.
CONFIG_ZMK_BLE_EXPERIMENTAL_CONN=y

# Deeper controller buffers absorb short fades; the reliability module also
# retains failed submissions and periodically repairs the current key state.
CONFIG_BT_BUF_ACL_TX_COUNT=8
CONFIG_BT_L2CAP_TX_BUF_COUNT=8
CONFIG_BT_CONN_TX_MAX=8

# Complete key-state snapshots awaiting transmission. The reliability module
# preserves order on retry and collapses overload to the latest complete state.
CONFIG_ZMK_SPLIT_BLE_PERIPHERAL_POSITION_QUEUE_SIZE=32

# Transmit at the radio's maximum, +8 dBm, instead of the 0 dBm default; see
# the left defconfig and docs/architecture.md for the rationale. On this part
# it applies to the link back to the central. Both directions of the split
# link gain margin only when every part sets it.
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Absorb a complete local key burst without dropping releases.
CONFIG_ZMK_KSCAN_EVENT_QUEUE_SIZE=64

# Leave stack margin for state repair and transport callbacks.
CONFIG_ZMK_SPLIT_BLE_PERIPHERAL_STACK_SIZE=1024
